    min-height:45px;
    min-width:45px;
    font-size:16px;
    border-radius:8px;
    border:1px solid #dddddd;
    background-color:#ffffff;
}
QPushButton#btn_add,#btn_sub,#btn_mul,#btn_div,#btn_eq{
    background-color:#ffb86c;
    color:white;
}
QPushButton#btn_clear,#btn_back{
    background-color:#ff5555;
    color:white;
}
QPushButton[objectName^=&quot;btn_&quot;]:hover{
    background-color:#dddddd;
}
